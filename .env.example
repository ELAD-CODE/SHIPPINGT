# Database Configuration
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
# Examples:
#   Local: postgresql://postgres:password@localhost:5432/shipment_tracking
#   Supabase: postgresql://postgres.[project].supabase.co/postgres?password=...
#   Railway: postgresql://...
DATABASE_URL="postgresql://postgres:password@localhost:5432/shipment_tracking"

# TrackingMore API Configuration
# Get API key from https://www.trackingmore.com
# Free tier: 100 calls/day
TRACKINGMORE_API_KEY="your_api_key_here"

# Optional: Redis for Rate Limiting (Upstash)
# Sign up at https://upstash.com
# UPSTASH_REDIS_REST_URL="https://..."
# UPSTASH_REDIS_REST_TOKEN="..."

# Environment
NODE_ENV="development"

# Optional: Error Tracking (Sentry)
# SENTRY_DSN="..."

# Optional: Analytics
# ANALYTICS_KEY="..."

# Optional: Email Service
# SMTP_HOST="..."
# SMTP_PORT="587"
# SMTP_USER="..."
# SMTP_PASSWORD="..."
# SMTP_FROM="..."
