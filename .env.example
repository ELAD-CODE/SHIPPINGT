# ============================================================================
# SHIPMENT TRACKING ISRAEL - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env.local for local development
# Never commit .env.local or any file containing real secrets to git
# ============================================================================

# ----------------------------------------------------------------------------
# APPLICATION CORE
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# Skip environment validation during build (set to true only for build processes)
SKIP_ENV_VALIDATION=false

# ----------------------------------------------------------------------------
# DATABASE
# ----------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/shipment_tracking

# Database connection settings
DATABASE_CONNECTION_TIMEOUT=30000
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# ----------------------------------------------------------------------------
# TRACKINGMORE API (Primary Tracking Service)
# ----------------------------------------------------------------------------
# Get your API key from: https://www.trackingmore.com/
# Free tier: 100 calls/day
TRACKINGMORE_API_KEY=your_trackingmore_api_key_here

# API configuration
TRACKINGMORE_API_TIMEOUT=10000
TRACKINGMORE_API_RETRIES=2
TRACKINGMORE_RATE_LIMIT_DELAY=100

# ----------------------------------------------------------------------------
# MAMAN API (Israeli Customs Broker System)
# ----------------------------------------------------------------------------
# Credentials for Maman Online API
MAMAN_USERNAME=your_maman_username
MAMAN_PASSWORD=your_maman_password

# ----------------------------------------------------------------------------
# SEARATES API (Maritime Tracking - Optional)
# ----------------------------------------------------------------------------
# Get your API key from: https://www.searates.com/
SEARATES_API_KEY=your_searates_api_key
SEARATES_API_TIMEOUT=15000
SEARATES_API_RETRIES=2

# ----------------------------------------------------------------------------
# AWS CONFIGURATION (For S3, Deployment, etc.)
# ----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=shipment-tracking-documents

# ----------------------------------------------------------------------------
# REDIS (Optional - For Caching & Rate Limiting)
# ----------------------------------------------------------------------------
FEATURE_REDIS_ENABLED=false
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Redis cache TTL (in seconds)
REDIS_CACHE_TTL_DEFAULT=3600
REDIS_CACHE_TTL_TRACKING=1800

# ----------------------------------------------------------------------------
# SECURITY
# ----------------------------------------------------------------------------
# Session secret - MUST be changed in production!
# Generate with: openssl rand -base64 32
SESSION_SECRET=REPLACE_WITH_RANDOM_32_CHAR_SECRET_GENERATE_WITH_OPENSSL

# JWT secret for authentication
JWT_SECRET=REPLACE_WITH_RANDOM_JWT_SECRET_MIN_32_CHARS

# Webhook secret for external integrations
WEBHOOK_SECRET=REPLACE_WITH_RANDOM_WEBHOOK_SECRET

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ----------------------------------------------------------------------------
# RATE LIMITING
# ----------------------------------------------------------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST_SIZE=100
RATE_LIMIT_WINDOW_MS=60000

# ----------------------------------------------------------------------------
# LOGGING & MONITORING
# ----------------------------------------------------------------------------
LOG_LEVEL=info

# Sentry Error Tracking (Optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACING_SAMPLE_RATE=0.1

# ----------------------------------------------------------------------------
# EMAIL CONFIGURATION (Optional)
# ----------------------------------------------------------------------------
EMAIL_FROM=noreply@shipmenttracking.net
# Add SMTP configuration if needed:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password

# ----------------------------------------------------------------------------
# FEATURE FLAGS
# ----------------------------------------------------------------------------
FEATURE_HEBREW_UI=true
FEATURE_TERMINAL_STORAGE_CALC=true
FEATURE_AWB_AUTO_DETECTION=true
FEATURE_MARITIME_TRACKING=true
FEATURE_ANALYTICS=false

# ----------------------------------------------------------------------------
# ANALYTICS (Optional)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_ANALYTICS_ID=

# Google Analytics (Optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ----------------------------------------------------------------------------
# TESTING
# ----------------------------------------------------------------------------
# Test environment overrides
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/shipment_tracking_test
