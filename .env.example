# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/shipment_tracking?schema=public"

# TrackingMore API
TRACKINGMORE_API_KEY="your_trackingmore_api_key_here"

# Maman Carrier API
MAMAN_USERNAME="your_maman_username"
MAMAN_PASSWORD="your_maman_password"

# Session & Security
SESSION_SECRET="your_session_secret_here_min_32_chars"

# AWS Configuration (for deployments)
AWS_ACCESS_KEY_ID="your_aws_access_key"
AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
AWS_REGION="us-east-1"
S3_BUCKET="your-s3-bucket-name"

# Application
NODE_ENV="development"
PORT="3000"

# Optional: Email/SMS providers (for notifications)
# SENDGRID_API_KEY=""
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_PHONE_NUMBER=""
