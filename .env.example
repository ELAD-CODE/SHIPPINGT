# ============================================================================
# ENVIRONMENT VARIABLES - Shipment Tracking Israel
# ============================================================================
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local or any file containing real secrets to git
# ============================================================================

# ----------------------------------------------------------------------------
# Application Configuration
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# ----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ----------------------------------------------------------------------------
# Format: postgresql://username:password@host:port/database
# Example: postgresql://user:password@localhost:5432/shipment_tracking
DATABASE_URL=postgresql://user:password@localhost:5432/shipment_tracking
DATABASE_CONNECTION_TIMEOUT=30000
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# ----------------------------------------------------------------------------
# TrackingMore API (Required)
# ----------------------------------------------------------------------------
# Get your API key from: https://www.trackingmore.com/
# Free tier: 100 calls/day
TRACKINGMORE_API_KEY=your_trackingmore_api_key_here
TRACKINGMORE_API_TIMEOUT=10000
TRACKINGMORE_API_RETRIES=2
TRACKINGMORE_RATE_LIMIT_DELAY=100

# ----------------------------------------------------------------------------
# Maman Customs API (Optional - for Israeli customs integration)
# ----------------------------------------------------------------------------
MAMAN_USERNAME=your_maman_username
MAMAN_PASSWORD=your_maman_password

# ----------------------------------------------------------------------------
# Security & Sessions
# ----------------------------------------------------------------------------
# Generate a strong random string for production (32+ characters)
# Example: openssl rand -base64 32
SESSION_SECRET=REPLACE_WITH_SECURE_RANDOM_STRING_MIN_32_CHARS
WEBHOOK_SECRET=REPLACE_WITH_SECURE_RANDOM_STRING

# CORS - Allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ----------------------------------------------------------------------------
# AWS Configuration (for deployment)
# ----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET=your_s3_bucket_name

# ----------------------------------------------------------------------------
# Redis (Optional - for caching and rate limiting)
# ----------------------------------------------------------------------------
FEATURE_REDIS_ENABLED=false
UPSTASH_REDIS_REST_URL=your_redis_url
UPSTASH_REDIS_REST_TOKEN=your_redis_token
REDIS_CACHE_TTL_DEFAULT=3600
REDIS_CACHE_TTL_TRACKING=1800

# ----------------------------------------------------------------------------
# Rate Limiting
# ----------------------------------------------------------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST_SIZE=100
RATE_LIMIT_WINDOW_MS=60000

# ----------------------------------------------------------------------------
# Logging & Monitoring
# ----------------------------------------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=development
SENTRY_TRACING_SAMPLE_RATE=0.1

# ----------------------------------------------------------------------------
# Email Configuration (Optional)
# ----------------------------------------------------------------------------
EMAIL_FROM=noreply@shipmenttracking.net
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password

# ----------------------------------------------------------------------------
# Feature Flags
# ----------------------------------------------------------------------------
FEATURE_HEBREW_UI=true
FEATURE_TERMINAL_STORAGE_CALC=true
FEATURE_AWB_AUTO_DETECTION=true
FEATURE_MARITIME_TRACKING=true
FEATURE_ANALYTICS=false

# ----------------------------------------------------------------------------
# Analytics (Optional)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_ANALYTICS_ID=your_analytics_id

# ----------------------------------------------------------------------------
# SeaRates Maritime API (Optional - for container tracking)
# ----------------------------------------------------------------------------
SEARATES_API_KEY=your_searates_api_key_here
SEARATES_API_TIMEOUT=15000
SEARATES_API_RETRIES=2

# ----------------------------------------------------------------------------
# JWT Configuration (Optional - for user authentication)
# ----------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# ----------------------------------------------------------------------------
# Testing
# ----------------------------------------------------------------------------
# Set to true to skip environment validation during tests
SKIP_ENV_VALIDATION=false
