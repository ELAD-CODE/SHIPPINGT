# ================================
# Shipment Tracking Israel
# Environment Variables Template
# ================================
# Copy this file to .env.local for development
# DO NOT commit .env files with real values to git

# ================================
# Application Core
# ================================
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# ================================
# Database
# ================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/shipment_tracking

# Optional Database Settings
DATABASE_CONNECTION_TIMEOUT=30000
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# ================================
# TrackingMore API
# ================================
# Get your API key from: https://www.trackingmore.com/api-index.html
TRACKINGMORE_API_KEY=your_trackingmore_api_key_here
TRACKINGMORE_API_TIMEOUT=10000
TRACKINGMORE_API_RETRIES=2

# ================================
# Maman Online API
# ================================
# Israeli customs clearance API
MAMAN_USERNAME=your_maman_username
MAMAN_PASSWORD=your_maman_password

# ================================
# Security
# ================================
# Generate a random string for session encryption
# Use: openssl rand -base64 32
SESSION_SECRET=your_session_secret_at_least_32_characters_long
JWT_SECRET=your_jwt_secret_for_token_signing

# Webhook secret for external integrations
WEBHOOK_SECRET=your_webhook_secret

# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ================================
# AWS Configuration
# ================================
# For S3 document storage and deployment
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET=shipment-tracking-documents

# ================================
# Optional: SeaRates Maritime API
# ================================
# For enhanced maritime tracking
FEATURE_MARITIME_TRACKING=true
SEARATES_API_KEY=your_searates_api_key_if_needed
SEARATES_API_TIMEOUT=15000

# ================================
# Optional: Redis (Caching & Rate Limiting)
# ================================
FEATURE_REDIS_ENABLED=false
UPSTASH_REDIS_REST_URL=your_redis_url
UPSTASH_REDIS_REST_TOKEN=your_redis_token
REDIS_CACHE_TTL_DEFAULT=3600
REDIS_CACHE_TTL_TRACKING=1800

# ================================
# Rate Limiting
# ================================
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST_SIZE=100
RATE_LIMIT_WINDOW_MS=60000

# ================================
# Monitoring & Logging
# ================================
LOG_LEVEL=info
SENTRY_DSN=your_sentry_dsn_for_error_tracking
SENTRY_ENVIRONMENT=development
SENTRY_TRACING_SAMPLE_RATE=0.1

# ================================
# Feature Flags
# ================================
FEATURE_HEBREW_UI=true
FEATURE_TERMINAL_STORAGE_CALC=true
FEATURE_AWB_AUTO_DETECTION=true
FEATURE_ANALYTICS=false

# ================================
# Analytics
# ================================
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_ANALYTICS_ID=your_analytics_id

# ================================
# Email
# ================================
EMAIL_FROM=noreply@shipmenttracking.net

# ================================
# Build & Deployment
# ================================
# Skip environment validation during build
SKIP_ENV_VALIDATION=false
