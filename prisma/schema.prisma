// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // או "sqlite" למקומי
  url      = env("DATABASE_URL")
}

// טבלת חיפושים - כל חיפוש שמישהו עשה
model TrackingSearch {
  id              String   @id @default(cuid())
  trackingNumber  String
  shipmentType    String?  // air_waybill, bill_of_lading, container, tracking_number
  carrier         String?
  found           Boolean  @default(false)
  
  // נתוני המשלוח (JSON)
  trackingData    Json?
  
  // CTA triggers
  showCta         Boolean  @default(false)
  ctaTriggers     Json?
  
  // מידע על החיפוש
  ipAddress       String?
  userAgent       String?
  searchedAt      DateTime @default(now())
  
  // קשר ללידים
  leads           Lead[]
  
  @@index([trackingNumber])
  @@index([searchedAt])
}

// טבלת לידים - אנשים שביקשו עזרה
model Lead {
  id              String   @id @default(cuid())
  
  // פרטי הלקוח
  fullName        String
  phone           String
  email           String?
  
  // פרטי המשלוח
  trackingNumber  String
  shipmentType    String?
  issue           String?  // customs, documents, cost_inquiry, general
  
  // סטטוס הטיפול
  status          String   @default("new") // new, contacted, in_progress, completed, closed
  priority        String   @default("medium") // low, medium, high, critical
  
  // הערות והיסטוריה
  notes           String?
  assignedTo      String?  // שם הסוכן שמטפל
  
  // קשר לחיפוש המקורי
  searchId        String?
  search          TrackingSearch? @relation(fields: [searchId], references: [id])
  
  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  contactedAt     DateTime?
  completedAt     DateTime?
  
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([phone])
}

// טבלת משתמשים רשומים (אופציונלי - למי שרוצה חשבון)
model User {
  id              String   @id @default(cuid())
  email           String   @unique
  phone           String?
  name            String?
  
  // Authentication (אם תרצה login)
  passwordHash    String?
  
  // Preferences
  notifyByEmail   Boolean  @default(true)
  notifyBySms     Boolean  @default(false)
  language        String   @default("he") // he, en
  
  // Saved trackings
  savedTrackings  SavedTracking[]
  
  createdAt       DateTime @default(now())
  lastLogin       DateTime?
  
  @@index([email])
}

// משלוחים שמורים למשתמשים רשומים
model SavedTracking {
  id              String   @id @default(cuid())
  
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  trackingNumber  String
  nickname        String?  // שם שהמשתמש נתן למשלוח
  shipmentType    String?
  carrier         String?
  
  // Notifications
  notifyOnArrival Boolean  @default(true)
  notifyOnCustoms Boolean  @default(true)
  notifyOnDelivery Boolean @default(true)
  
  // Cache של נתונים אחרונים
  lastStatus      String?
  lastUpdate      DateTime?
  
  createdAt       DateTime @default(now())
  
  @@unique([userId, trackingNumber])
  @@index([userId])
}

// טבלת הודעות (SMS/Email/WhatsApp) שנשלחו
model Notification {
  id              String   @id @default(cuid())
  
  // למי
  recipient       String   // phone או email
  recipientType   String   // phone, email, whatsapp
  
  // מה
  subject         String?
  message         String
  
  // בקשר למה
  trackingNumber  String?
  leadId          String?
  
  // סטטוס
  status          String   @default("pending") // pending, sent, failed
  provider        String?  // twilio, sendgrid, etc
  providerId      String?  // ID מהספק
  
  sentAt          DateTime?
  failedAt        DateTime?
  errorMessage    String?
  
  createdAt       DateTime @default(now())
  
  @@index([status])
  @@index([trackingNumber])
}

// טבלת Analytics - למעקב אחרי ביצועים
model Analytics {
  id              String   @id @default(cuid())
  date            DateTime @default(now())
  
  // מטריקות יומיות
  totalSearches   Int      @default(0)
  uniqueVisitors  Int      @default(0)
  totalLeads      Int      @default(0)
  conversionRate  Float?   // leads / searches
  
  // פירוט לפי סוג משלוח
  awbSearches     Int      @default(0)
  blSearches      Int      @default(0)
  containerSearches Int    @default(0)
  trackingSearches Int     @default(0)
  
  // CTAs
  ctaShown        Int      @default(0)
  ctaClicked      Int      @default(0)
  
  @@unique([date])
}

// ============================================================================
// טבלת משלוחים - תמיכה מלאה במשלוחים אוויריים וימיים
// ============================================================================
enum ShipmentType {
  AIR         // משלוח אווירי (Air Freight)
  SEA         // משלוח ימי (Sea Freight)
  ROAD        // משלוח יבשתי (Road Freight)
  EXPRESS     // משלוח אקספרס (DHL, FedEx, etc.)
}

model Shipment {
  id              String       @id @default(cuid())
  
  // ==== Basic Shipment Info ====
  trackingNumber  String       @unique
  shipmentType    ShipmentType @default(EXPRESS)
  
  // ==== Customer Info ====
  customerName    String?
  customerEmail   String?
  customerPhone   String?
  
  // ==== Origin & Destination ====
  originCountry   String?      // ISO country code (e.g., CN, US)
  originPort      String?      // Port or airport code
  originAddress   String?
  
  destinationCountry String?   // ISO country code (IL for Israel)
  destinationPort    String?   // Port or airport code (e.g., ILHFA for Haifa)
  destinationAddress String?
  
  // ==== Air Freight Specific Fields ====
  airWaybillNumber String?     // AWB number (e.g., 157-12345678)
  flightNumber     String?
  airline          String?      // Carrier name
  aircraftType     String?
  
  // ==== Sea Freight Specific Fields ====
  billOfLading     String?     // B/L number (e.g., MAEU123456789)
  containerNumber  String?     // Container number (e.g., MSCU1234567)
  vesselName       String?     // Name of the vessel/ship
  voyageNumber     String?     // Voyage/trip number
  containerType    String?     // 20ft, 40ft, 40HC, etc.
  containerCount   Int?        // Number of containers (default: 1)
  
  // ==== Document Management ====
  blDocumentUrl    String?     // URL to B/L document (S3, etc.)
  invoiceUrl       String?     // Commercial invoice
  packingListUrl   String?     // Packing list
  certificateUrl   String?     // Certificate of origin, etc.
  
  // ==== Cargo Details ====
  cargoDescription String?     // Description of goods
  hsCode           String?     // Harmonized System code
  weight           Float?      // Weight in kg
  volume           Float?      // Volume in m³
  quantity         Int?        // Number of pieces/packages
  declaredValue    Float?      // Declared customs value
  currency         String?     @default("USD")
  
  // ==== Status & Timeline ====
  status           String       @default("booked") // booked, in_transit, customs, delivered, etc.
  statusHe         String?      // Hebrew status translation
  
  bookingDate      DateTime?
  departureDate    DateTime?
  arrivalDate      DateTime?
  estimatedArrival DateTime?
  deliveryDate     DateTime?
  
  // ==== Customs & Clearance ====
  customsStatus    String?      // pending, in_progress, cleared, held
  customsDate      DateTime?
  customsNotes     String?
  dutyPaid         Boolean      @default(false)
  dutyAmount       Float?
  
  // ==== Tracking & External Data ====
  carrier          String?      // Carrier/shipping line (e.g., MAERSK, MSC)
  carrierCode      String?      // Carrier code for API lookups
  externalTrackingData Json?    // JSON from TrackingMore/SeaRates API
  
  // ==== Internal Management ====
  assignedTo       String?      // Employee handling this shipment
  priority         String       @default("normal") // low, normal, high, urgent
  notes            String?      // Internal notes
  tags             String[]     // Tags for categorization
  
  // ==== Timestamps ====
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  
  // ==== Relationships ====
  // Link to leads if customer requested help
  leadId           String?
  
  // ==== Indexes for Performance ====
  @@index([trackingNumber])
  @@index([shipmentType])
  @@index([status])
  @@index([customsStatus])
  @@index([customerEmail])
  @@index([billOfLading])
  @@index([containerNumber])
  @@index([airWaybillNumber])
  @@index([createdAt])
  @@index([departureDate])
  @@index([arrivalDate])
}