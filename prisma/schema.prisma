// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // או "sqlite" למקומי
  url      = env("DATABASE_URL")
}

// טבלת חיפושים - כל חיפוש שמישהו עשה
model TrackingSearch {
  id              String   @id @default(cuid())
  trackingNumber  String
  shipmentType    String?  // air_waybill, bill_of_lading, container, tracking_number
  carrier         String?
  found           Boolean  @default(false)
  
  // נתוני המשלוח (JSON)
  trackingData    Json?
  
  // CTA triggers
  showCta         Boolean  @default(false)
  ctaTriggers     Json?
  
  // מידע על החיפוש
  ipAddress       String?
  userAgent       String?
  searchedAt      DateTime @default(now())
  
  // קשר ללידים
  leads           Lead[]
  
  @@index([trackingNumber])
  @@index([searchedAt])
}

// טבלת לידים - אנשים שביקשו עזרה
model Lead {
  id              String   @id @default(cuid())
  
  // פרטי הלקוח
  fullName        String
  phone           String
  email           String?
  
  // פרטי המשלוח
  trackingNumber  String
  shipmentType    String?
  issue           String?  // customs, documents, cost_inquiry, general
  
  // סטטוס הטיפול
  status          String   @default("new") // new, contacted, in_progress, completed, closed
  priority        String   @default("medium") // low, medium, high, critical
  
  // הערות והיסטוריה
  notes           String?
  assignedTo      String?  // שם הסוכן שמטפל
  
  // קשר לחיפוש המקורי
  searchId        String?
  search          TrackingSearch? @relation(fields: [searchId], references: [id])
  
  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  contactedAt     DateTime?
  completedAt     DateTime?
  
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([phone])
}

// טבלת משתמשים רשומים (אופציונלי - למי שרוצה חשבון)
model User {
  id              String   @id @default(cuid())
  email           String   @unique
  phone           String?
  name            String?
  
  // Authentication (אם תרצה login)
  passwordHash    String?
  
  // Preferences
  notifyByEmail   Boolean  @default(true)
  notifyBySms     Boolean  @default(false)
  language        String   @default("he") // he, en
  
  // Saved trackings
  savedTrackings  SavedTracking[]
  
  createdAt       DateTime @default(now())
  lastLogin       DateTime?
  
  @@index([email])
}

// משלוחים שמורים למשתמשים רשומים
model SavedTracking {
  id              String   @id @default(cuid())
  
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  trackingNumber  String
  nickname        String?  // שם שהמשתמש נתן למשלוח
  shipmentType    String?
  carrier         String?
  
  // Notifications
  notifyOnArrival Boolean  @default(true)
  notifyOnCustoms Boolean  @default(true)
  notifyOnDelivery Boolean @default(true)
  
  // Cache של נתונים אחרונים
  lastStatus      String?
  lastUpdate      DateTime?
  
  createdAt       DateTime @default(now())
  
  @@unique([userId, trackingNumber])
  @@index([userId])
}

// טבלת הודעות (SMS/Email/WhatsApp) שנשלחו
model Notification {
  id              String   @id @default(cuid())
  
  // למי
  recipient       String   // phone או email
  recipientType   String   // phone, email, whatsapp
  
  // מה
  subject         String?
  message         String
  
  // בקשר למה
  trackingNumber  String?
  leadId          String?
  
  // סטטוס
  status          String   @default("pending") // pending, sent, failed
  provider        String?  // twilio, sendgrid, etc
  providerId      String?  // ID מהספק
  
  sentAt          DateTime?
  failedAt        DateTime?
  errorMessage    String?
  
  createdAt       DateTime @default(now())
  
  @@index([status])
  @@index([trackingNumber])
}

// טבלת Analytics - למעקב אחרי ביצועים
model Analytics {
  id              String   @id @default(cuid())
  date            DateTime @default(now())
  
  // מטריקות יומיות
  totalSearches   Int      @default(0)
  uniqueVisitors  Int      @default(0)
  totalLeads      Int      @default(0)
  conversionRate  Float?   // leads / searches
  
  // פירוט לפי סוג משלוח
  awbSearches     Int      @default(0)
  blSearches      Int      @default(0)
  containerSearches Int    @default(0)
  trackingSearches Int     @default(0)
  
  // CTAs
  ctaShown        Int      @default(0)
  ctaClicked      Int      @default(0)
  
  @@unique([date])
}

// ============================================================================
// טבלת משלוחים - תמיכה מלאה במשלוחים אוויריים וימיים
// ============================================================================
model Shipment {
  id                  String        @id @default(cuid())
  
  // פרטי זיהוי בסיסיים
  trackingNumber      String        @unique
  referenceNumber     String?       // מספר הזמנה פנימי
  
  // סוג המשלוח (ENUM)
  shipmentType        ShipmentType  // air, sea, road
  
  // פרטי מוביל כלליים
  carrier             String?       // שם חברת השילוח
  carrierCode         String?       // קוד חברת השילוח
  
  // מיקומים
  originCountry       String?
  originCity          String?
  originPort          String?       // נמל/שדה תעופה מקור
  destinationCountry  String?
  destinationCity     String?
  destinationPort     String?       // נמל/שדה תעופה יעד
  
  // סטטוס ותאריכים
  status              String        @default("pending") // pending, in_transit, at_port, customs, delivered
  statusHe            String?       // תרגום עברי של הסטטוס
  
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  estimatedDelivery   DateTime?
  actualDelivery      DateTime?
  
  // ========== שדות למשלוחים ימיים (SEA) ==========
  
  // פרטי קונטיינר
  containerNumber     String?       // מספר קונטיינר (ISO 6346 format)
  containerType       String?       // 20ft, 40ft, 40HC, etc.
  containerCount      Int?          // מספר קונטיינרים במשלוח
  
  // פרטי כלי שיט
  vesselName          String?       // שם הספינה
  vesselIMO           String?       // IMO number של הספינה
  voyageNumber        String?       // מספר הפלגה
  
  // Bill of Lading (B/L)
  blNumber            String?       // מספר שטר מטען
  blType              String?       // Original, Telex Release, SeaWaybill
  blDocumentUrl       String?       // קישור למסמך B/L
  
  // פרטי נמל
  portOfLoading       String?       // נמל העמסה
  portOfDischarge     String?       // נמל פריקה
  
  // תאריכים ימיים
  etd                 DateTime?     // Estimated Time of Departure
  atd                 DateTime?     // Actual Time of Departure
  eta                 DateTime?     // Estimated Time of Arrival
  ata                 DateTime?     // Actual Time of Arrival
  
  // ========== שדות למשלוחים אוויריים (AIR) ==========
  
  // Air Waybill (AWB)
  awbNumber           String?       // מספר שטר מטען אווירי
  awbPrefix           String?       // 3 ספרות ראשונות (קוד חברת תעופה)
  
  // פרטי טיסה
  flightNumber        String?       // מספר טיסה
  flightDate          DateTime?     // תאריך טיסה
  airline             String?       // חברת תעופה
  airlineCode         String?       // קוד IATA של חברת תעופה
  
  // ========== שדות כלליים נוספים ==========
  
  // משקל ומידות
  weight              Float?        // משקל בק"ג
  volume              Float?        // נפח במ"ק
  pieces              Int?          // מספר חבילות/יחידות
  
  // ערך ומסמכים
  declaredValue       Float?        // ערך מוצהר
  currency            String?       // מטבע
  invoiceUrl          String?       // קישור לחשבונית
  packingListUrl      String?       // קישור לרשימת אריזה
  
  // פרטי מכס
  customsStatus       String?       // pending, cleared, inspection
  customsDate         DateTime?     // תאריך שחרור מכס
  customsReference    String?       // מספר התיק במכס
  
  // הערות ומידע נוסף
  notes               String?       // הערות כלליות
  specialInstructions String?       // הוראות מיוחדות
  incoterm            String?       // תנאי מסירה (FOB, CIF, etc.)
  
  // מידע טכני
  trackingData        Json?         // נתונים גולמיים מ-API
  lastTracked         DateTime?     // עדכון אחרון מ-API
  
  // קשרים
  userId              String?       // משתמש שיצר/בעלים
  
  @@index([trackingNumber])
  @@index([shipmentType])
  @@index([status])
  @@index([containerNumber])
  @@index([blNumber])
  @@index([awbNumber])
  @@index([estimatedDelivery])
  @@index([createdAt])
}

// ENUM לסוגי משלוחים
enum ShipmentType {
  air   // משלוח אווירי (AWB)
  sea   // משלוח ימי (Container/B/L)
  road  // משלוח יבשתי
}